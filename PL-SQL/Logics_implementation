--Exercise – Even/Odd

DECLARE
    v_number NUMBER := 15;
BEGIN

    IF MOD(v_number, 2) = 0 THEN
        DBMS_OUTPUT.PUT_LINE('Even');
    ELSE
        DBMS_OUTPUT.PUT_LINE('Odd');
    END IF;

END;
/

--Exercise – Largest of Three Numbers

DECLARE
    a NUMBER := 25;
    b NUMBER := 50;
    c NUMBER := 35;
    largest NUMBER;
BEGIN

    IF a >= b AND a >= c THEN
        largest := a;

    ELSIF b >= a AND b >= c THEN
        largest := b;

    ELSE
        largest := c;

    END IF;

    DBMS_OUTPUT.PUT_LINE(
        'Largest = ' || largest
    );

END;
/

-- Exercise – Factorial

DECLARE
    v_number NUMBER := 5;
    v_factorial NUMBER := 1;
BEGIN

    FOR i IN 1..v_number
    LOOP
        v_factorial := v_factorial * i;
    END LOOP;

    DBMS_OUTPUT.PUT_LINE(
        'Factorial = ' || v_factorial
    );

END;
/

-- Exercise – Fibonacci

DECLARE
    v_first NUMBER := 0;
    v_second NUMBER := 1;
    v_next NUMBER;
BEGIN

    DBMS_OUTPUT.PUT_LINE(v_first);
    DBMS_OUTPUT.PUT_LINE(v_second);

    FOR i IN 3..10
    LOOP

        v_next := v_first + v_second;

        DBMS_OUTPUT.PUT_LINE(v_next);

        v_first := v_second;
        v_second := v_next;

    END LOOP;

END;
