DECLARE
    v_salary HR.EMPLOYEES.SALARY%TYPE;
BEGIN
    SELECT SALARY
    INTO v_salary
    FROM HR.EMPLOYEES
    WHERE EMPLOYEE_ID = 105;

    DBMS_OUTPUT.PUT_LINE(
        'Employee Salary: ' || v_salary
    );
END;
/
