-- Explicit cursor using OPEN, FETCH and CLOSE

/* Concepts: Explicit cursor, OPEN, FETCH, CLOSE, %NOTFOUND.
- OPEN executes the cursor query.
- FETCH retrieves one row at a time.
- %NOTFOUND becomes true when the last fetch fails to return a row.
- CLOSE releases the cursor.   */
DECLARE
    CURSOR c_emp IS
        SELECT FIRST_NAME, LAST_NAME, SALARY
        FROM HR.EMPLOYEES
        WHERE DEPARTMENT_ID = 50;

    v_first_name HR.EMPLOYEES.FIRST_NAME%TYPE;
    v_last_name  HR.EMPLOYEES.LAST_NAME%TYPE;
    v_salary     HR.EMPLOYEES.SALARY%TYPE;
BEGIN
    OPEN c_emp;

    LOOP
        FETCH c_emp
        INTO v_first_name, v_last_name, v_salary;

        EXIT WHEN c_emp%NOTFOUND;

        DBMS_OUTPUT.PUT_LINE(
            v_first_name || ' ' ||
            v_last_name || ' - ' || v_salary
        );
    END LOOP;

    CLOSE c_emp;
END;
/



