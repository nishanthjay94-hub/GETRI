/* Cursor attributes %FOUND, %NOTFOUND, %ROWCOUNT, %ISOPEN
Problem: Display the first employee fetched from department 50 and demonstrate cursor attributes. */

DECLARE
    CURSOR c_emp IS
        SELECT EMPLOYEE_ID, FIRST_NAME
        FROM HR.EMPLOYEES
        WHERE DEPARTMENT_ID = 50
        ORDER BY EMPLOYEE_ID;

    v_id   HR.EMPLOYEES.EMPLOYEE_ID%TYPE;
    v_name HR.EMPLOYEES.FIRST_NAME%TYPE;
BEGIN
    OPEN c_emp;

    DBMS_OUTPUT.PUT_LINE(
        'Cursor open: ' ||
        CASE WHEN c_emp%ISOPEN THEN 'YES' ELSE 'NO' END
    );

    FETCH c_emp INTO v_id, v_name;

    IF c_emp%FOUND THEN
        DBMS_OUTPUT.PUT_LINE(
            'Employee: ' || v_id || ' - ' || v_name
        );
    ELSE
        DBMS_OUTPUT.PUT_LINE('No employee found.');
    END IF;

    DBMS_OUTPUT.PUT_LINE(
        'Rows fetched: ' || c_emp%ROWCOUNT
    );

    CLOSE c_emp;

    DBMS_OUTPUT.PUT_LINE(
        'Cursor open after close: ' ||
        CASE WHEN c_emp%ISOPEN THEN 'YES' ELSE 'NO' END
    );
END;
/





