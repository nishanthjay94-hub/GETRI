/*
DATA ISSUES - EXCEPTION HANDLING

Employee doesn't exist
Duplicate employee
Invalid number
Division by zero
Multiple records returned
*/

#Basic Exception Structure
BEGIN

  -- normal processing

EXCEPTION

  WHEN exception_name THEN
      -- error handling

END;
/

# NO_DATA_FOUND

DECLARE
  v_salary employees.salary%TYPE;
BEGIN

  SELECT salary
  INTO v_salary
  FROM employees
  WHERE employee_id = 999;

  DBMS_OUTPUT.PUT_LINE(v_salary);

EXCEPTION

  WHEN NO_DATA_FOUND THEN
      DBMS_OUTPUT.PUT_LINE(
          'Employee does not exist.'
      );

END;
/

# multiple rows for the same category

DECLARE
  v_salary employees.salary%TYPE;
BEGIN

  SELECT salary
  INTO v_salary
  FROM employees
  WHERE department_id = 10;

EXCEPTION

  WHEN TOO_MANY_ROWS THEN
      DBMS_OUTPUT.PUT_LINE(
          'Multiple employees found.'
      );

END;
/

# zero divide

DECLARE
  v_result NUMBER;
BEGIN

  v_result := 100 / 0;

EXCEPTION

  WHEN ZERO_DIVIDE THEN
      DBMS_OUTPUT.PUT_LINE(
          'Cannot divide by zero.'
      );

END;
/

#INVALID NUMBER

DECLARE
  v_number NUMBER;
BEGIN

  v_number := TO_NUMBER('ABC');

EXCEPTION

  WHEN INVALID_NUMBER THEN
      DBMS_OUTPUT.PUT_LINE(
          'Invalid number entered.'
      );

END;
/

#VALUE_ERROR

DECLARE
  v_name VARCHAR2(5);
BEGIN

  v_name := 'ABCDEFGHIJK';

EXCEPTION

  WHEN VALUE_ERROR THEN
      DBMS_OUTPUT.PUT_LINE(
          'Value is too large or invalid.'
      );

END;
/

# SQL CODE ERROR

EXCEPTION

  WHEN OTHERS THEN
      DBMS_OUTPUT.PUT_LINE(
          'Error Code: ' || SQLCODE
      );

END;
/

# User-Defined Exception

/*  Suppose business rule:

Salary cannot be less than ₹20,000.  */

DECLARE
  v_salary NUMBER := 15000;

  e_invalid_salary EXCEPTION;

BEGIN

  IF v_salary < 20000 THEN
      RAISE e_invalid_salary;
  END IF;

  DBMS_OUTPUT.PUT_LINE(
      'Salary is valid.'
  );

EXCEPTION

  WHEN e_invalid_salary THEN
      DBMS_OUTPUT.PUT_LINE(
          'Salary cannot be below 20,000.'
      );

END;
/
