Example 1: BEFORE INSERT trigger
Problem: Prevent inserting an employee with a salary less than or equal to zero.


CREATE OR REPLACE TRIGGER trg_check_salary
BEFORE INSERT ON EMP_DEMO
FOR EACH ROW
BEGIN
    IF :NEW.SALARY <= 0 THEN
        RAISE_APPLICATION_ERROR(
            -20001,
            'Salary must be greater than zero'
        );
    END IF;
END;
/

INSERT INTO EMP_DEMO
VALUES (102, 'Ravi', -5000, 50);

Example 2: AFTER UPDATE trigger with :OLD and :NEW


CREATE TABLE SALARY_AUDIT (
    EMPLOYEE_ID NUMBER(6),
    OLD_SALARY NUMBER(8,2),
    NEW_SALARY NUMBER(8,2),
    CHANGE_DATE DATE
);



CREATE OR REPLACE TRIGGER trg_salary_audit
AFTER UPDATE OF SALARY ON EMP_DEMO
FOR EACH ROW
BEGIN
    INSERT INTO SALARY_AUDIT (
        EMPLOYEE_ID,
        OLD_SALARY,
        NEW_SALARY,
        CHANGE_DATE
    )
    VALUES (
        :OLD.EMPLOYEE_ID,
        :OLD.SALARY,
        :NEW.SALARY,
        SYSDATE
    );
END;
/

UPDATE EMP_DEMO
SET SALARY = 25000
WHERE EMPLOYEE_ID = 100;

SELECT *
FROM SALARY_AUDIT;

Example 3: Statement-level DELETE trigger


CREATE OR REPLACE TRIGGER trg_delete_message
AFTER DELETE ON EMP_DEMO
BEGIN
    DBMS_OUTPUT.PUT_LINE(
        'A DELETE statement was executed on EMP_DEMO.'
    );
END;
/


